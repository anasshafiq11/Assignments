@model Assignment2.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <h2>User Management</h2>
    <hr />

    <div class="card mb-4 bg-light">
        <div class="card-header bg-secondary text-white">
            <h5 class="card-title mb-0" style="font-size: 1.1rem;">Dependency Injection Diagnostics</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="w-25 ps-3">Singleton App Id</th>
                        <td class="text-monospace">@ViewBag.ApplicationId</td>
                    </tr>
                    <tr>
                        <th scope="row" class="ps-3">Application Start Time</th>
                        <td>@ViewBag.StartTime</td>
                    </tr>
                    <tr>
                        <th scope="row" class="ps-3">Transient Request Id</th>
                        <td class="text-monospace">@ViewBag.RequestId</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="mb-3 text-end">
            <a class="btn btn-success"
               asp-controller="Account"
               asp-action="InviteUser">
                <i class="bi bi-person-plus"></i> Create New User
            </a>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label font-weight-bold small">Filter Expression</label>
                    <input type="text"
                           name="FilterExpression"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="e.g., Email.Contains(), FirstName="anas" />
                </div>

                <div class="col-md-3">
                    <label class="form-label font-weight-bold small">Order By Expression</label>
                    <input type="text"
                           name="OrderByExpression"
                           value="@Model.SortOrder"
                           class="form-control"
                           placeholder="e.g., FirstName descending" />
                </div>

                <div class="col-md-2">
                    <label class="form-label font-weight-bold small">Offset </label>
                    <input type="number"
                           name="Skip"
                           value="@(Context.Request.Query["Skip"].FirstOrDefault() ?? "0")"
                           class="form-control"
                           min="0" />
                </div>

                <div class="col-md-1">
                    <label class="form-label font-weight-bold small">Limit </label>
                    <input type="number"
                           name="Take"
                           value="@(Context.Request.Query["Take"].FirstOrDefault() ?? "10")"
                           class="form-control"
                           min="1" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        Apply Query
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Physical Address</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-center" style="width: 180px;">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Users != null && Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><strong>@user.FirstName @user.LastName</strong></td>
                            <td>@user.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(user.Address) ? "No Address Provided" : user.Address)</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@user.Id"
                                       class="btn btn-warning btn-sm me-1">Edit</a>

                                    <form asp-action="Delete"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          style="display:inline">
                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete @user.FirstName?')">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(User.IsInRole("Admin") ? 4 : 3)" class="text-center text-muted py-4">
                            No users match the query criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 mb-5">
        <div class="text-muted small">
            Showing Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
        </div>

        @if (Model.TotalPages > 1)
        {
            string currentTakeStr = Context.Request.Query["Take"].FirstOrDefault() ?? "10";
            int currentTake = int.TryParse(currentTakeStr, out var parsedTake) ? parsedTake : 10;

            <nav aria-label="User navigation list">
                <ul class="pagination mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        // Calculate what the 'Skip' offset value needs to be dynamically based on the current Take value
                        int calculatedSkip = (i - 1) * currentTake; 

                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Skip="@calculatedSkip"
                               asp-route-Take="@currentTake"
                               asp-route-FilterExpression="@Model.Search"
                               asp-route-OrderByExpression="@Model.SortOrder">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>