@model Assignment2.Models.Product

<h2>Edit Product</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input asp-for="Price"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Quantity</label>
        <input asp-for="Quantity"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Update
    </button>

</form>